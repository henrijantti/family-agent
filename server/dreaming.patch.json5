// Family bot's weekly review ("dreaming", Henri 2026-10-25). Apply with
// `openclaw config patch --file server/dreaming.patch.json5` as openclaw.
// - `dreaming` MCP server for the Chief of staff only: this week's findings from the
//   family group, and the "Opittua perheryhmästä" block of the family bot's USER.md
// - OpenClaw's own memory dreaming off: it promotes into MEMORY.md, which group
//   sessions never load, and its nightly sweep also read the Email agent's sessions
//   (DREAMS.md in the email workspace). Email content must never feed dreaming
// Arrays replace on patch, so each list repeats what is live (2026-10-25).
{
  plugins: { entries: { "memory-core": { config: { dreaming: { enabled: false } } } } },
  agents: {
    entries: {
      henri: { tools: { alsoAllow: ["family__*", "brain__*", "desk__*", "jobs__*", "dreaming__*", "view_image"] } },
      main: { tools: { deny: ["mail__*", "family__*", "brain__*", "desk__*", "jobs__*", "familygroup__*", "jobsgroup__*", "dreaming__*"] } },
      email: {
        tools: {
          deny: ["group:runtime", "group:fs", "browser", "image_generate", "sessions_spawn", "sessions_send", "family__*", "brain__*", "desk__*", "jobs__*", "familygroup__*", "jobsgroup__*", "dreaming__*"],
        },
      },
      family: {
        tools: {
          deny: [
            "group:runtime", "group:fs", "browser", "image_generate", "sessions_spawn", "sessions_send",
            "brain__*", "mail__*", "desk__*", "family__*", "jobs__*", "dreaming__*",
          ],
        },
      },
    },
  },
  mcp: {
    servers: {
      dreaming: { command: "/home/openclaw/family-agent-run.sh", args: ["mcp", "dreaming"] },
    },
  },
  tools: { sandbox: { tools: { alsoAllow: ["mail__*", "family__*", "brain__*", "desk__*", "jobs__*", "familygroup__*", "jobsgroup__*", "dreaming__*"] } } },
}
