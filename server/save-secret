#!/bin/bash
# Saves one family-agent secret typed at a hidden prompt (2026-10-26, for the Drive
# OAuth client). Installed to /usr/local/sbin/save-secret (root:root 755). From the laptop:
#   ssh -t root@<server> save-secret GOOGLE_OAUTH_CLIENT_ID
# Writes ~openclaw/.secrets/family-agent/<NAME> (openclaw:root 600), the folder
# family-agent-run.sh loads as environment variables. Never prints the value.
# SECRETS_DIR overrides the target folder (used for testing).
set -euo pipefail
name="${1:?usage: save-secret <NAME>}"
[[ "$name" =~ ^[A-Z][A-Z0-9_]{2,63}$ ]] || { echo "name must be UPPER_CASE letters, digits, underscores"; exit 2; }
dir="${SECRETS_DIR:-/home/openclaw/.secrets/family-agent}"

read -rsp "Paste $name (hidden), then Enter: " v; echo
v="$(printf '%s' "$v" | tr -d '\r\n ')"
[ -n "$v" ] || { echo "empty; nothing saved"; exit 1; }

umask 077
install -d -m 700 "$dir"
printf '%s' "$v" > "$dir/$name"
if id openclaw >/dev/null 2>&1; then chown openclaw:root "$dir/$name"; fi
chmod 600 "$dir/$name"
echo "saved $name, ${#v} chars"
unset v
